# Public URL the tool hub uses to reach this tool (your ngrok / cloudflare tunnel URL)
tool_url=
# Base URL of the tool hub, used to fetch the busy period's messages
hub_url=
# Shared secret in the registration JSON, lets the tool post summaries via the hub's /api/send
catchup_secret=
# Anthropic API key for the summaries
ANTHROPIC_API_KEY=
# Only if your Anthropic key isn't scoped to a workspace: the workspace ID
ANTHROPIC_WORKSPACE_ID=

# --- optional tuning (defaults in brackets) ---
# A burst is this many times the group's usual busy hour (5)...
CATCHUP_MULTIPLIER=
# ...and at least this many messages in an hour (30)
CATCHUP_MINIMUM=
# Messages in an hour that count as a burst until the tool has 3 days of history (100)
CATCHUP_FALLBACK=
# Minutes of quiet before a burst is summarised (15)
CATCHUP_QUIET_MINUTES=
# A burst that keeps going is summarised after this many hours anyway (3)
CATCHUP_MAX_HOURS=
# Time zone for the times shown in summaries (Europe/London)
CATCHUP_TIME_ZONE=
# Port to listen on (5066)
PORT=
